# Google Maps JavaScript API — copy to .env.local (dev) or set in your
# production build environment. Browser keys are public by design: protect
# them with HTTP-referrer + API restrictions in Google Cloud (see README).
VITE_GOOGLE_MAPS_API_KEY=your-browser-api-key

# Map ID (JavaScript, vector) with POIs/business labels hidden via cloud
# styling. Leave empty in development to use Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=your-map-id
